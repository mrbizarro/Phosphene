---
import { SITE } from '../data/site';
const year = 2026;
// Footer mark, drawn as rings of radial dashes so each ring can turn on its own.
const rings = [
  { r0: 19, r1: 29, n: 24, c: '#ff3d86' },
  { r0: 36, r1: 46, n: 36, c: '#e2369a' },
  { r0: 54, r1: 62, n: 44, c: '#ba5ce4' },
  { r0: 71, r1: 80, n: 56, c: '#8e4ddf' },
  { r0: 87, r1: 95, n: 66, c: '#6f7cf0' },
  { r0: 103, r1: 111, n: 80, c: '#37cfe3' },
].map((ring) => ({
  ...ring,
  d: Array.from({ length: ring.n }, (_, i) => {
    const t = (i / ring.n) * Math.PI * 2;
    const c = Math.cos(t), s = Math.sin(t);
    return `M${(ring.r0 * c).toFixed(2)} ${(ring.r0 * s).toFixed(2)}L${(ring.r1 * c).toFixed(2)} ${(ring.r1 * s).toFixed(2)}`;
  }).join(''),
}));
---
<footer class="site-foot">
  <div class="wrap">
    <div class="cols">
      <div>
        <p class="stand" style="max-width: 26ch">Phosphene <span class="dim">for Mac.</span> <em>Free, open-source AI video with sound.</em> Make songs and images too. All on your Mac.</p>
      </div>
      <div>
        <h2>Product</h2>
        <ul>
          <li><a href="/download/">Get Phosphene for Mac</a></li>
          <li><a href="/features/">Features</a></li>
          <li><a href="/gallery/">Gallery</a></li>
          <li><a href="/pricing/">Free · Pro · Founding Lifetime</a></li>
          <li><a href="/docs/">Docs</a></li>
          <li><a href="/docs/faq/">FAQ</a></li>
          <li><a href="/benchmarks/">Speed benchmarks</a></li>
        </ul>
      </div>
      <div>
        <h2>The project</h2>
        <ul>
          <li><a href="/open-source/">Open source</a></li>
          <li><a href={SITE.repo} rel="noopener">GitHub</a></li>
          <li><a href="/changelog/">Changelog</a></li>
          <li><a href="/blog/">Blog</a></li>
        </ul>
      </div>
      <div>
        <h2>Contact and info</h2>
        <ul>
          <li><a href="/contact/">Contact</a></li>
          <li><a href={SITE.x} rel="noopener">X {SITE.xHandle}</a></li>
          <li><a href="/pricing/">Pro &amp; Founding Lifetime · coming soon</a></li>
          <li><a href="/press/">Press kit</a></li>
          <li><a href={`mailto:${SITE.email}`}>Support: {SITE.email}</a></li>
          <li><a href="/terms/">Terms of Service</a></li>
          <li><a href="/refunds/">Refund policy</a></li>
          <li><a href="/privacy/">Privacy policy</a></li>
          <li><a href="/acceptable-use/">Acceptable use</a></li>
        </ul>
      </div>
    </div>
    <div class="huge foot-logo" aria-hidden="true">
      <svg class="foot-mark" viewBox="-112 -114 224 228" width="224" height="228">
        {rings.map((ring, i) => (
          <g class={`fm-morph fm-m${i}`}>
            <g class={`fm-spin fm-s${i}`}>
              <path d={ring.d} stroke={ring.c} stroke-width="2.6" stroke-linecap="round" fill="none" />
            </g>
          </g>
        ))}
        <circle class="fm-core" r="5" fill="#f8e24e" />
      </svg>
      <img class="foot-word" src="/brand/wordtext_lg.webp" width="826" height="228" alt="" loading="lazy" />
    </div>
    <div class="legal">
      <span>© {year} Mr Bizarro · App MIT licensed · model weights under their own licences</span>
      <span><a href={SITE.releaseUrl} data-gh-release rel="noopener">v<span data-gh="version">{SITE.version}</span></a> · made on a Mac</span>
    </div>
    <p class="small">Phosphene is free, open-source desktop software for Apple Silicon Macs that runs AI models locally. We host no generation service; Pro is coming soon.</p>
    <p class="small">Phosphene is independent and not affiliated with Lightricks, MiniMax, Black Forest Labs, Alibaba or the other model makers. Model names belong to their owners.</p>
  </div>
</footer>
