---
import { SITE, STATS } from '../data/site';
const path = Astro.url.pathname;
// The bar carries six; the phone sheet and the footer carry all of them.
const links = [
  { href: '/features/', label: 'Features' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/docs/', label: 'Docs' },
  { href: '/benchmarks/', label: 'Benchmarks' },
  { href: '/changelog/', label: 'Changelog' },
  { href: '/pricing/', label: 'Pricing' },
];
const more = [
  { href: '/open-source/', label: 'Open source' },
  { href: '/blog/', label: 'Blog' },
];
const dockLinks = links.filter((l) => l.href !== '/changelog/');
const cta = { href: '/download/', label: 'Get Phosphene free' };
const here = (href: string) => path === href || path.startsWith(href);
const stars = STATS.stars.toLocaleString('en-US');
const starsLabel = 'Phosphene on GitHub, {stars} stars';
const gh = 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z';
---
<header class="site-head" data-head>
  <div class="bar">
    <a href="/" class="logo" aria-label="Phosphene home" aria-current={path === '/' ? 'page' : undefined}>
      <svg class="mark" width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
        <g fill="none" transform="rotate(-90 13 13)">
          <g class="hm-morph hm-m0"><circle class="hm-spin hm-s0" cx="13" cy="13" r="11" stroke="#5EEAFF" stroke-width="2" stroke-dasharray="1.15 1.73" /></g>
          <g class="hm-morph hm-m1"><circle class="hm-spin hm-s1" cx="13" cy="13" r="7.7" stroke="#B14AFF" stroke-width="2.1" stroke-dasharray="1.1 1.59" /></g>
          <g class="hm-morph hm-m2"><circle class="hm-spin hm-s2" cx="13" cy="13" r="4.5" stroke="#FF2E9F" stroke-width="2" stroke-dasharray="1 1.36" /></g>
        </g>
        <circle class="hm-core" cx="13" cy="13" r="1.5" fill="#FFD23F" />
      </svg>
      <span class="word-clip"><img class="word" src="/brand/wordtext@2x.webp" srcset="/brand/wordtext@2x.webp 2x, /brand/wordtext@3x.webp 3x" width="120" height="20" alt="Phosphene" /></span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={here(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="tail">
      <a class="gh" href={SITE.repo} rel="noopener" data-gh-label={starsLabel} aria-label={starsLabel.replace('{stars}', stars)}>
        <span><svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d={gh} /></svg></span>
        <span class="gh-star" aria-hidden="true"><svg width="11" height="11" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.6l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.5l-5.9 3.1 1.2-6.5L2.5 9.5l6.6-.9z"/></svg><span data-gh="stars">{stars}</span></span>
      </a>
      <a class="cta" href={cta.href} aria-current={here(cta.href) ? 'page' : undefined}>{cta.label}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open menu" data-menu>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="dock" data-dock inert>
    <a class="mk" href="/" aria-label="Phosphene home">
      <svg width="24" height="24" viewBox="0 0 26 26" aria-hidden="true">
        <g fill="none" transform="rotate(-90 13 13)">
          <g class="hm-morph hm-m0"><circle class="hm-spin hm-s0" cx="13" cy="13" r="11" stroke="#5EEAFF" stroke-width="2" stroke-dasharray="1.15 1.73" /></g>
          <g class="hm-morph hm-m1"><circle class="hm-spin hm-s1" cx="13" cy="13" r="7.7" stroke="#B14AFF" stroke-width="2.1" stroke-dasharray="1.1 1.59" /></g>
          <g class="hm-morph hm-m2"><circle class="hm-spin hm-s2" cx="13" cy="13" r="4.5" stroke="#FF2E9F" stroke-width="2" stroke-dasharray="1 1.36" /></g>
        </g>
        <circle class="hm-core" cx="13" cy="13" r="1.5" fill="#FFD23F" />
      </svg>
    </a>
    <ul>
      {dockLinks.map((l) => (
        <li><a class="lnk" href={l.href} aria-current={here(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <a class="cta" href={cta.href}>{cta.label}</a>
  </div>

  <div class="sheet" id="site-menu" data-sheet hidden>
    <nav class="wrap" aria-label="Menu">
      <ul>
        {[...links, ...more].map((l, i) => (
          <li style={`--i:${i}`}><a href={l.href} aria-current={here(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a class="sheet-cta" href={cta.href} style={`--i:${links.length + more.length}`}>{cta.label} for Mac</a>
      <div class="sheet-foot mono" style={`--i:${links.length + more.length + 1}`}>
        <a href={SITE.repo} rel="noopener">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d={gh} /></svg>
          GitHub · ★ <span data-gh="stars">{stars}</span>
        </a>
        <a href={SITE.releaseUrl} rel="noopener" data-gh-release>v<span data-gh="version">{SITE.version}</span></a>
      </div>
    </nav>
  </div>
</header>
